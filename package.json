{
  "author": "Jason Williscroft",
  "bugs": {
    "url": "https://github.com/karmaniverous/serify-deserify/issues"
  },
  "dependencies": {
    "is-what": "^5.5.7"
  },
  "description": "Reversibly transform unserializable values into serializable ones. Includes Redux middleware.",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.34.1",
    "@eslint/js": "^10.0.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "git-cliff": "^2.14.2",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.9",
    "release-it": "^21.1.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.3",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/karmaniverous/serify-deserify#readme",
  "keywords": [
    "bigint",
    "deserialize",
    "date",
    "json",
    "map",
    "parse",
    "redux",
    "serialize",
    "serializable",
    "set",
    "state",
    "stringify",
    "typescript"
  ],
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "name": "@karmaniverous/serify-deserify",
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@reduxjs/toolkit": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run knip",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ],
      "after:bump": [
        "npx git-cliff -o CHANGELOG.md",
        "npm run docs",
        "git add CHANGELOG.md"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/serify-deserify.git"
  },
  "scripts": {
    "build": "rimraf dist && rollup --config rollup.config.ts --configPlugin \"typescript={incremental:false,outputToFilesystem:false}\"",
    "changelog": "git-cliff -o CHANGELOG.md",
    "docs": "typedoc",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.prerelease --preRelease",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "3.0.0"
}
